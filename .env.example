# ==============================================================================
# Leo: Multi-Agent AI Tutor - Environment Configuration Template
# Copy this file to .env and fill in your values. Never commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary LLM Provider: Google Gemini (Recommended)
# Get your free API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# Model ID: gemini/gemini-3.5-flash (fastest & most stable) or gemini/gemini-3.7-flash
LEO_MODEL=gemini/gemini-3.5-flash

# ------------------------------------------------------------------------------
# 2. Alternative LLM Providers (Optional - leave blank if using Gemini)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 3. Agent Execution & Orchestration Settings
# ------------------------------------------------------------------------------
# Stall protection: Maximum seconds to wait before Coordinator retries an agent
LEO_TIMEOUT=90

# Maximum retry attempts if an agent stalls or API fails
LEO_RETRIES=2

# Number of practice questions generated by the Quiz Master per session
LEO_N_QUESTIONS=4

# Passing score threshold percentage (scores below this trigger the Bonus Feedback Loop)
LEO_PASS_PCT=70

# Maximum number of remedial re-teaching cycles in the Bonus Feedback Loop
LEO_MAX_RELEARN=2
